/.idea
/build

# Generated by the golden mk's lint target. Committing it means every lint
# run dirties the tree and blocks comment-gate, which diffs COMMITTED work.
.golangci.merged.yml

# Fetched from pipeline-catalog by fetch-mk: a cache of a remote file, never a
# source of truth. refresh-mk deletes it deliberately.
.leartech-go.mk

# Coverage profiles. A tracked cover.out put leartech-maestro-service#27 at
# 1.07MB and every ai-review model rejected the diff on context length, so the
# PR was scored 0/100 having never been read.
cover.out
coverage.out
coverage.html

# Written by the jx-variables step at build time. Never commit it: jx preserves any value the
# file already holds, so a tracked copy freezes the cluster it was written on. This one came
# from the mqube fork and named jx3mqubebuild.azurecr.io / spring-financial-group long after
# the repo moved to us-central1-docker.pkg.dev/product-first / oci, and jx kept those values.
.jx/variables.sh
